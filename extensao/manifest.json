{
  "manifest_version": 3,
  "name": "Shopia — apresentadora de IA para lives",
  "version": "1.1.0",
  "description": "Toca o áudio da sua live no LIVE Studio pelo cabo virtual, lê o chat e reporta — com a voz que você escolheu no painel.",
  "default_locale": "pt_BR",

  "permissions": ["storage", "alarms", "sidePanel", "tabs"],

  "host_permissions": [
    "*://*.tiktok.com/*",
    "https://liveshopia.up.railway.app/*"
  ],

  "background": {
    "service_worker": "fundo.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "painel.html"
  },

  "action": {
    "default_title": "Shopia — abrir painel",
    "default_icon": {
      "16": "icones/16.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  },

  "icons": {
    "16": "icones/16.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["conteudo.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["seletores.js"],
      "matches": ["*://*.tiktok.com/*"]
    }
  ],

  "minimum_chrome_version": "116"
}
