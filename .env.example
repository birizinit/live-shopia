# -----------------------------------------------------------------------------
# Shopia — variáveis de ambiente
#
# Copie para .env.local. Sem DATABASE_URL o app sobe em MODO DEMO: sessão falsa,
# dados de exemplo, nada persiste. Demo é bloqueado em produção.
#
# Regra sem exceção para serviço externo: sem chave, a funcionalidade ou mostra
# exemplo CLARAMENTE rotulado, ou fica desligada. O que nunca acontece é
# simular — em especial pagamento: PIX falso é fraude, não demonstração.
# -----------------------------------------------------------------------------

# Postgres. Na Railway, referencie o serviço em vez de colar a senha:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Localmente, use a URL do proxy público (turntable.proxy.rlwy.net:PORTA).
DATABASE_URL=

# Só se o servidor exigir TLS. A rede interna da Railway não exige.
# DATABASE_SSL=require

# URL pública. Entra nos links de confirmação e redefinição de senha.
# Na Railway pode deixar em branco: cai no RAILWAY_PUBLIC_DOMAIN sozinho.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Worker da fila, dentro do processo Next (instrumentation.ts).
# Em produção liga sozinho. Em desenvolvimento fica DESLIGADO de propósito:
# a fila mora no banco, e se você apontar o .env.local para o banco de
# produção, um worker local passaria a processar job de cliente com código
# não publicado. Ligue só quando for isso mesmo que você quer.
# SHOPIA_WORKER=1

# Força o modo demo mesmo com banco configurado (só desenvolvimento).
# SHOPIA_DEMO=1


# --- Fase 1 — roteiro e voz ---------------------------------------------------
# Sem estas chaves: roteiro e áudio saem como EXEMPLO, rotulado na interface.
ANTHROPIC_API_KEY=
# Padrão: claude-opus-5. Só mude se souber por quê.
# ANTHROPIC_MODELO=claude-opus-5
ELEVENLABS_API_KEY=
# ELEVENLABS_MODELO=eleven_multilingual_v2

# --- Fase 2 — armazenamento ---------------------------------------------------
# Hoje o áudio mora no próprio Postgres, em blocos de ~2 MB (o arquivo contínuo
# de 3h nunca é materializado). R2 é opcional e entra atrás da mesma interface.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Fase 3 — pagamento -------------------------------------------------------
# Gateway ainda não escolhido (PLANO.md §9.1). Recomendação: Asaas, por causa
# de assinatura recorrente em PIX e da API de transferência para comissão.
# Sem GATEWAY_TOKEN + GATEWAY_NOME, comprar e assinar ficam DESABILITADOS.
GATEWAY_NOME=
GATEWAY_TOKEN=
GATEWAY_WEBHOOK_SEGREDO=

# --- Fase 4 — notificações push ----------------------------------------------
# Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Fase 5 — extensão --------------------------------------------------------
# Segredo que assina o token de licença da extensão.
EXTENSAO_SEGREDO=

# --- Fase 6 — afiliados / KYC -------------------------------------------------
# Pepper do HMAC de CPF. SHA cru de 11 dígitos é quebrável por força bruta em
# minutos; com pepper fora do banco, um dump sozinho não revela CPF.
KYC_PEPPER=

# --- E-mail transacional ------------------------------------------------------
# Sem a chave, o conteúdo vai para o log do servidor e nenhum e-mail sai.
RESEND_API_KEY=
# EMAIL_REMETENTE=Shopia <nao-responda@seudominio.com.br>

# --- Operação -----------------------------------------------------------------
# Segredo para acionar a faxina por cron externo, se um dia sair do worker.
CRON_SEGREDO=
