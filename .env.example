# -----------------------------------------------------------------------------
# Shopia — variáveis de ambiente
# Copie para .env.local. Sem DATABASE_URL o app sobe em MODO DEMO: sessão falsa,
# qualquer e-mail entra, nada persiste. Demo é bloqueado em produção.
# -----------------------------------------------------------------------------

# Postgres. Na Railway, referencie o serviço em vez de colar a senha:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Localmente, use a URL do proxy público (turntable.proxy.rlwy.net:PORTA).
DATABASE_URL=

# Só se o servidor exigir TLS. A rede interna da Railway não exige.
# DATABASE_SSL=require

# URL pública do app. Entra nos links de confirmação e redefinição de senha.
# Na Railway pode deixar em branco: cai no RAILWAY_PUBLIC_DOMAIN sozinho.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail transacional. Sem a chave, o conteúdo vai para o log do servidor e o
# link aparece no terminal — o que basta em desenvolvimento.
# RESEND_API_KEY=
# EMAIL_REMETENTE=Shopia <nao-responda@seudominio.com.br>

# Força o modo demo mesmo com banco configurado (só desenvolvimento).
# SHOPIA_DEMO=1

# -----------------------------------------------------------------------------
# Fases seguintes — ainda não lidas pelo código
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=          # fase 1 — roteiro de vendas (Claude)
# ELEVENLABS_API_KEY=         # fase 1 — TTS e clonagem de voz
# REDIS_URL=                  # fase 1 — fila de jobs (BullMQ/Upstash)
# R2_ACCOUNT_ID=              # fase 2 — storage dos áudios
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# GATEWAY_TOKEN=              # fase 3 — PIX/cartão (definir o gateway: PLANO.md §9.1)
# VAPID_PUBLIC_KEY=           # fase 4 — web push
# VAPID_PRIVATE_KEY=
