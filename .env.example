# -----------------------------------------------------------------------------
# Shopia — variáveis de ambiente
# Copie para .env.local. Sem estas chaves o app sobe em MODO DEMO: sessão falsa,
# qualquer e-mail entra, nada persiste. Demo é bloqueado em produção.
# -----------------------------------------------------------------------------

# Supabase — Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servidor. Ignora RLS: só em job, webhook e rota de servidor.
# Nunca prefixar com NEXT_PUBLIC_ — isso a mandaria para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app. Entra nos links de confirmação e redefinição de senha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Força o modo demo mesmo com Supabase configurado (só para desenvolvimento).
# SHOPIA_DEMO=1

# -----------------------------------------------------------------------------
# Fases seguintes — ainda não lidas pelo código
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=          # fase 1 — roteiro de vendas (Claude)
# ELEVENLABS_API_KEY=         # fase 1 — TTS e clonagem de voz
# REDIS_URL=                  # fase 1 — fila de jobs (BullMQ/Upstash)
# R2_ACCOUNT_ID=              # fase 2 — storage dos áudios
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# GATEWAY_TOKEN=              # fase 3 — PIX/cartão (definir o gateway: PLANO.md §9.1)
# VAPID_PUBLIC_KEY=           # fase 4 — web push
# VAPID_PRIVATE_KEY=
